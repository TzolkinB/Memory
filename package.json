{
  "name": "memory-game",
  "version": "1.0.0",
  "description": "Memory/Concentration card game.",
  "main": "app.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TzolkinB/Memory"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "dossier": "node --experimental-strip-types scripts/summarize-failure-dossier.ts",
    "type-check": "tsc --noEmit",
    "test": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:ui": "playwright test --ui",
    "test:visual": "dotenv -- percy exec -- playwright test --project=visual",
    "prepare": "husky"
  },
  "author": "Kimberly Bell",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "mdb-react-ui-kit": "^10.0.0",
    "prop-types": "^15.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@percy/cli": "^1.31.14",
    "@percy/playwright": "^1.1.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.1"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  }
}
