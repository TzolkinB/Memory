{
  "name": "memory-game",
  "version": "1.0.0",
  "description": "Memory/Concentration card game.",
  "main": "app.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TzolkinB/Memory"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "dossier": "node --experimental-strip-types scripts/summarize-failure-dossier.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:visual": "playwright test tests/visual-smoke-baseline.spec.ts",
    "test:visual:update": "playwright test tests/visual-smoke-baseline.spec.ts --update-snapshots",
    "prepare": "husky"
  },
  "author": "Kimberly Bell",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "mdb-react-ui-kit": "^7.2.0",
    "prop-types": "^15.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.4.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  }
}
